Sys.sleep(DELAY_TIME)
formSubmit("form20", "name=identifier", username)
Sys.sleep(DELAY_TIME)
# get passed choose authentication method, I do password
b$Runtime$evaluate('btn = document.querySelector(\'a[aria-label="Select Password."]\');
if(btn){
btn.click()
}
')
